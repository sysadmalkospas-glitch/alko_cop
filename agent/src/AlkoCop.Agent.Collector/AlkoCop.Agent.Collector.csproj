<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: процесс без консольного окна, пользователь его не видит. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AlkoCopCollector</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.1.0" GeneratePathProperty="true" />
    <ProjectReference Include="..\AlkoCop.Agent.Core\AlkoCop.Agent.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(PkgMagick_NET-Q8-x64)' != ''">
    <None Include="$(PkgMagick_NET-Q8-x64)/Notice.txt" Link="Magick.NET.Notice.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
