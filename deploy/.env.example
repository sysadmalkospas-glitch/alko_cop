POSTGRES_PASSWORD=поменяйте-на-длинный-пароль
# Ключ регистрации агентов: тот же ключ прописывается в настройки агента при установке.
ALKOCOP_ENROLL_KEY=поменяйте-на-длинный-ключ
# Каталог для скриншотов на диске сервера.
SCREENSHOT_PATH=./data/screenshots
# DNS-имя или IP сервера, без схемы и порта; должен совпадать с SAN сертификата.
ALKOCOP_HOST=alkocop.internal
ALKOCOP_HTTPS_PORT=443
# internal — собственный CA Caddy; custom — сертификат и ключ из файлов.
ALKOCOP_TLS_MODE=internal
ALKOCOP_CERTS_DIR=./certs
# Измените оба параметра, если подсеть пересекается с существующей сетью Docker/VPN.
ALKOCOP_PROXY_SUBNET=172.30.240.0/24
ALKOCOP_PROXY_IP=172.30.240.2
