POSTGRES_PASSWORD=поменяйте-на-длинный-пароль
# Ключ регистрации агентов: тот же ключ прописывается в настройки агента при установке.
ALKOCOP_ENROLL_KEY=поменяйте-на-длинный-ключ
# Каталог для скриншотов на диске сервера.
SCREENSHOT_PATH=./data/screenshots
SERVER_PORT=8000
# Только для локальной разработки через HTTP; в рабочей среде оставьте true.
ALKOCOP_AUTH_COOKIE_SECURE=true
